; Tests for src/compress/inflate.ll : raw/zlib/gzip INFLATE, adler32/crc32,
; overlap back-reference copy, dynamic Huffman on ~64 KiB, truncated-stream
; errors, and deflate_stored / deflate_fixed round trips.

declare i64 @universe_compress_inflate(ptr, i64, ptr, i64)
declare i64 @universe_compress_inflate_zlib(ptr, i64, ptr, i64)
declare i64 @universe_compress_inflate_gzip(ptr, i64, ptr, i64)
declare i64 @universe_compress_adler32(ptr, i64)
declare i64 @universe_compress_crc32(ptr, i64)
declare i64 @universe_compress_deflate_stored(ptr, i64, ptr, i64)
declare i64 @universe_compress_deflate_fixed(ptr, i64, ptr, i64)

declare void @ut_check(i1, ptr)
declare void @ut_check_eq(i64, i64, ptr)
declare i1 @ut_want_bench(i32, ptr)
declare double @ut_now_sec()
declare void @ut_report_dist(ptr, i64, i64, ptr)
declare i32 @ut_summary()
declare i32 @memcmp(ptr, ptr, i64)
declare i32 @printf(ptr, ...)

@s_wiki = private constant [9 x i8] c"Wikipedia", align 1
@s_fox  = private constant [43 x i8] c"The quick brown fox jumps over the lazy dog", align 1

@m_raw   = private constant [16 x i8] c"raw inflate len\00", align 1
@m_rawc  = private constant [16 x i8] c"raw inflate cmp\00", align 1
@m_zl    = private constant [13 x i8] c"zlib inf len\00", align 1
@m_zlc   = private constant [13 x i8] c"zlib inf cmp\00", align 1
@m_gz    = private constant [13 x i8] c"gzip inf len\00", align 1
@m_gzc   = private constant [13 x i8] c"gzip inf cmp\00", align 1
@m_empty = private constant [12 x i8] c"empty zlib\0a\00", align 1
@m_rle   = private constant [16 x i8] c"rle overlap len\00", align 1
@m_rlec  = private constant [16 x i8] c"rle overlap cmp\00", align 1
@m_big   = private constant [16 x i8] c"big dynamic len\00", align 1
@m_bigc  = private constant [16 x i8] c"big dynamic cmp\00", align 1
@m_tr1   = private constant [16 x i8] c"trunc zlib err \00", align 1
@m_tr2   = private constant [16 x i8] c"trunc raw err  \00", align 1
@m_ad1   = private constant [16 x i8] c"adler wikipedia\00", align 1
@m_ad2   = private constant [16 x i8] c"adler orig_zlib\00", align 1
@m_crc1  = private constant [12 x i8] c"crc32 fox  \00", align 1
@m_crc2  = private constant [12 x i8] c"crc32 gzip \00", align 1
@m_st1   = private constant [16 x i8] c"stored enc ok  \00", align 1
@m_st2   = private constant [16 x i8] c"stored rt len  \00", align 1
@m_st3   = private constant [16 x i8] c"stored rt cmp  \00", align 1
@m_fx1   = private constant [16 x i8] c"fixed enc ok   \00", align 1
@m_fx2   = private constant [16 x i8] c"fixed rt len   \00", align 1
@m_fx3   = private constant [16 x i8] c"fixed rt cmp   \00", align 1
@infl.samp = internal global [16 x double] zeroinitializer, align 8
@lbl.infl = private unnamed_addr constant [25 x i8] c"inflate zlib 8027B->128K\00"

define i32 @main(i32 %argc, ptr %argv) {
entry:
  %obuf = alloca [131072 x i8], align 16
  %ebuf = alloca [131072 x i8], align 16

  ; ---- raw deflate ----
  %n_raw = call i64 @universe_compress_inflate(ptr %obuf, i64 131072, ptr @cv_raw, i64 22)
  call void @ut_check_eq(i64 %n_raw, i64 53, ptr @m_raw)
  %cmp_raw = call i32 @memcmp(ptr %obuf, ptr @orig_raw, i64 53)
  %ok_raw = icmp eq i32 %cmp_raw, 0
  call void @ut_check(i1 %ok_raw, ptr @m_rawc)

  ; ---- zlib ----
  %n_zl = call i64 @universe_compress_inflate_zlib(ptr %obuf, i64 131072, ptr @cv_zlib, i64 55)
  call void @ut_check_eq(i64 %n_zl, i64 180, ptr @m_zl)
  %cmp_zl = call i32 @memcmp(ptr %obuf, ptr @orig_zlib, i64 180)
  %ok_zl = icmp eq i32 %cmp_zl, 0
  call void @ut_check(i1 %ok_zl, ptr @m_zlc)

  ; ---- gzip (FNAME header) ----
  %n_gz = call i64 @universe_compress_inflate_gzip(ptr %obuf, i64 131072, ptr @cv_gzip, i64 56)
  call void @ut_check_eq(i64 %n_gz, i64 72, ptr @m_gz)
  %cmp_gz = call i32 @memcmp(ptr %obuf, ptr @orig_gzip, i64 72)
  %ok_gz = icmp eq i32 %cmp_gz, 0
  call void @ut_check(i1 %ok_gz, ptr @m_gzc)

  ; ---- empty ----
  %n_e = call i64 @universe_compress_inflate_zlib(ptr %obuf, i64 131072, ptr @cv_empty_zlib, i64 8)
  call void @ut_check_eq(i64 %n_e, i64 0, ptr @m_empty)

  ; ---- rle overlap (dist=1 and dist=2 runs) ----
  %n_rle = call i64 @universe_compress_inflate(ptr %obuf, i64 131072, ptr @cv_rle, i64 13)
  call void @ut_check_eq(i64 %n_rle, i64 600, ptr @m_rle)
  %cmp_rle = call i32 @memcmp(ptr %obuf, ptr @orig_rle, i64 600)
  %ok_rle = icmp eq i32 %cmp_rle, 0
  call void @ut_check(i1 %ok_rle, ptr @m_rlec)

  ; ---- big ~64 KiB dynamic huffman ----
  %n_big = call i64 @universe_compress_inflate_zlib(ptr %obuf, i64 131072, ptr @cv_big, i64 8027)
  call void @ut_check_eq(i64 %n_big, i64 65599, ptr @m_big)
  %cmp_big = call i32 @memcmp(ptr %obuf, ptr @orig_big, i64 65599)
  %ok_big = icmp eq i32 %cmp_big, 0
  call void @ut_check(i1 %ok_big, ptr @m_bigc)

  ; ---- truncated streams -> negative ----
  %n_t1 = call i64 @universe_compress_inflate_zlib(ptr %obuf, i64 131072, ptr @cv_zlib, i64 20)
  %bad1 = icmp slt i64 %n_t1, 0
  call void @ut_check(i1 %bad1, ptr @m_tr1)
  %n_t2 = call i64 @universe_compress_inflate(ptr %obuf, i64 131072, ptr @cv_raw, i64 4)
  %bad2 = icmp slt i64 %n_t2, 0
  call void @ut_check(i1 %bad2, ptr @m_tr2)

  ; ---- adler32 / crc32 known values ----
  %ad1 = call i64 @universe_compress_adler32(ptr @s_wiki, i64 9)
  call void @ut_check_eq(i64 %ad1, i64 300286872, ptr @m_ad1)
  %ad2 = call i64 @universe_compress_adler32(ptr @orig_zlib, i64 180)
  call void @ut_check_eq(i64 %ad2, i64 4200611997, ptr @m_ad2)
  %crc1 = call i64 @universe_compress_crc32(ptr @s_fox, i64 43)
  call void @ut_check_eq(i64 %crc1, i64 1095738169, ptr @m_crc1)
  %crc2 = call i64 @universe_compress_crc32(ptr @orig_gzip, i64 72)
  call void @ut_check_eq(i64 %crc2, i64 3829468544, ptr @m_crc2)

  ; ---- deflate_stored round trip on the big buffer ----
  %e_st = call i64 @universe_compress_deflate_stored(ptr %ebuf, i64 131072, ptr @orig_big, i64 65599)
  %st_ok = icmp sgt i64 %e_st, 0
  call void @ut_check(i1 %st_ok, ptr @m_st1)
  %d_st = call i64 @universe_compress_inflate(ptr %obuf, i64 131072, ptr %ebuf, i64 %e_st)
  call void @ut_check_eq(i64 %d_st, i64 65599, ptr @m_st2)
  %cmp_st = call i32 @memcmp(ptr %obuf, ptr @orig_big, i64 65599)
  %ok_st = icmp eq i32 %cmp_st, 0
  call void @ut_check(i1 %ok_st, ptr @m_st3)

  ; ---- deflate_fixed round trip ----
  %e_fx = call i64 @universe_compress_deflate_fixed(ptr %ebuf, i64 131072, ptr @orig_zlib, i64 180)
  %fx_ok = icmp sgt i64 %e_fx, 0
  call void @ut_check(i1 %fx_ok, ptr @m_fx1)
  %d_fx = call i64 @universe_compress_inflate(ptr %obuf, i64 131072, ptr %ebuf, i64 %e_fx)
  call void @ut_check_eq(i64 %d_fx, i64 180, ptr @m_fx2)
  %cmp_fx = call i32 @memcmp(ptr %obuf, ptr @orig_zlib, i64 180)
  %ok_fx = icmp eq i32 %cmp_fx, 0
  call void @ut_check(i1 %ok_fx, ptr @m_fx3)

  ; ---- bench ----
  %wb = call i1 @ut_want_bench(i32 %argc, ptr %argv)
  br i1 %wb, label %bench, label %fin

bench:
  ; 17 reps of a 2000-inflate batch; discard rep 0 (warm-up), report over the
  ; remaining 16. ops/rep = 2000 * 8027 = 16054000 compressed input bytes
  ; (ns per compressed byte).
  br label %inf.rep

inf.rep:
  %irep = phi i64 [ 0, %bench ], [ %irep.n, %inf.next ]
  %it0 = call double @ut_now_sec()
  br label %bloop

bloop:
  %bi = phi i64 [ 0, %inf.rep ], [ %bi.n, %bloop ]
  %bn = call i64 @universe_compress_inflate_zlib(ptr %obuf, i64 131072, ptr @cv_big, i64 8027)
  %bi.n = add i64 %bi, 1
  %bmore = icmp ult i64 %bi.n, 2000
  br i1 %bmore, label %bloop, label %inf.rep.done

inf.rep.done:
  %it1 = call double @ut_now_sec()
  %iel = fsub double %it1, %it0
  %ikeep = icmp ugt i64 %irep, 0
  br i1 %ikeep, label %inf.store, label %inf.next

inf.store:
  %iidx = sub i64 %irep, 1
  %isp = getelementptr inbounds [16 x double], ptr @infl.samp, i64 0, i64 %iidx
  store double %iel, ptr %isp, align 8
  br label %inf.next

inf.next:
  %irep.n = add nuw i64 %irep, 1
  %imore = icmp ult i64 %irep.n, 17
  br i1 %imore, label %inf.rep, label %inf.report

inf.report:
  call void @ut_report_dist(ptr @infl.samp, i64 16, i64 16054000, ptr @lbl.infl)
  br label %fin

fin:
  %r = call i32 @ut_summary()
  ret i32 %r
}
